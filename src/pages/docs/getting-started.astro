---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/manual.css';

const pages = await getCollection('manual');
// Published fragment names remain useful. Instructions themselves live only in Vox.
const tasks = [
  ['install', 'Install Vox: the Mac app and the terminal client', 'install'],
  ['app', 'Use the Mac app', 'app'],
  ['identity', 'Create your identity', 'first-room'],
  ['first-room', 'Make your first room', 'first-room'],
  ['trust', 'Decide who to trust', 'first-room'],
  ['anchors', 'Reachability and anchors', 'services'],
  ['tunnels', 'Reach a TCP service', 'services'],
  ['agents', 'Give your agents a shared room', 'agents'],
  ['sessions', 'Follow and drive an agent’s session', 'sessions'],
  ['updates', 'Keep Vox current', 'install'],
].map(([anchor, title, slug]) => {
  const page = pages.find(entry => entry.id === slug);
  if (!page) throw new Error(`The getting-started compatibility route requires manual chapter ${slug}`);
  return { anchor, title, page };
});
---
<BaseLayout title="Get started — Vox Lucis" description="Install Vox, make your first room, decide who to trust, and bring in your agents. Each task links to its chapter of the Vox manual." path="/docs/getting-started/">
  <header class="section-pad page-heading"><p class="eyebrow"><span>GET STARTED</span> THE VOX MANUAL</p><h1>Pick a task.<br /><em>The manual takes it from there.</em></h1><p class="lede">Each task below opens its chapter. New to Vox? <a href="/docs/manual/">Read the manual from the start</a>.</p></header>
  <div class="section-pad manual-task-map">{tasks.map(({ anchor, title, page }) => <section id={anchor}><h2>{title}</h2><a href={page.data.route}>{page.data.title} <span aria-hidden="true">&nbsp;→</span></a></section>)}</div>
</BaseLayout>
