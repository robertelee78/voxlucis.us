{
  "name": "voxlux-us",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.22.0 <25" },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:installer": "node --test scripts/installer-transport.test.mjs",
    "verify:published": "node scripts/verify-published.mjs",
    "verify": "npm run check && npm run test:installer && npm run build && npm run verify:dist"
  },
  "dependencies": { "astro": "7.2.3" },
  "devDependencies": { "@astrojs/check": "0.9.10", "typescript": "6.0.3" }
}
